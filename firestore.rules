rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /analyses/{id} {
      function isOwner() { return request.auth != null && resource.data.uid == request.auth.uid; }
      allow read, delete: if isOwner();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','title','input','analysis','receipt','triage','notes','certaintyBefore','certaintyAfter','createdAt','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 3000;
      allow update: if isOwner()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly(['uid','title','input','analysis','receipt','triage','notes','certaintyBefore','certaintyAfter','createdAt','updatedAt'])
        && request.resource.data.notes.size() <= 3000;
    }
  }
}
