GEMINI_API_KEY=
GEMINI_MODEL=
# Optional thinking level: low | medium | high (defaults to medium)
GEMINI_THINKING_LEVEL=medium

# Optional rate limiting: max requests per window per IP (production default: 20, non-prod: 120)
RATE_LIMIT_MAX=20
# Optional rate limit window in seconds (default: 600)
RATE_LIMIT_WINDOW_SECONDS=600
# Optional global per-instance cap on analysis calls per hour (default: 300)
RATE_LIMIT_GLOBAL_MAX=300
# Optional allowed cross-origin hosts (comma-separated list, e.g. https://perspectra.vercel.app)
ALLOWED_ORIGINS=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

